{
  "name": "WordKeeper",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Save words while browsing. Double-click or right-click to keep a word, then email or copy your collection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "WordKeeper",
    "default_popup": "src/popup/popup.html"
  },
  "permissions": ["storage", "contextMenus", "identity"],
  "oauth2": {
    "client_id": "408425653124-6r7fhbtol5ocv124rpn9ge3qfen9mdtq.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.send"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
}
